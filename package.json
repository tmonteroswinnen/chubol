{
  "name": "chubol",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "CHUBOL - juego arcade de basquet en el patio",
  "scripts": {
    "dev": "vite",
    "dev:celular": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "celular": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "capture": "node scripts/capture.mjs screenshots",
    "capture:mobile": "node scripts/captureMobile.mjs",
    "test:touch": "node scripts/touchFlow.mjs",
    "test:pwa": "node scripts/pwaCheck.mjs",
    "test:tactil": "node scripts/touchMulti.mjs",
    "capture:tiro": "node scripts/shotShots.mjs",
    "capture:ui": "node scripts/uiShots.mjs",
    "capture:hud": "node scripts/hudShot.mjs",
    "test:robusto": "node scripts/robustCheck.mjs",
    "test:maquina": "node scripts/cpuCheck.mjs"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "playwright-core": "^1.63.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
